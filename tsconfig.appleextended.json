{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@common/*": ["src/common/*"],
			"@target/*": [
				"src/appleextended/*.compat.ts",
				"src/appleextended/*"
			]
		}
	},
	"include": [
		"src/appleextended/**/*.ts",
		"generated/appleextended/typings/**/*.d.ts"
	],
	"exclude": [
		"src/common",
		"src/kaizpatch",
		"src/mc1710",
		"src/mc1122",
		"generated/kaizpatch",
		"generated/mc1710",
		"generated/mc1122"
	]
}
